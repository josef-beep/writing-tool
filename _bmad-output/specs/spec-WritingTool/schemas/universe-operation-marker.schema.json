{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universe-operation-marker.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "$ref": "foundation.schema.json#/$defs/uuid"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest"
  ],
  "additionalProperties": false
}
