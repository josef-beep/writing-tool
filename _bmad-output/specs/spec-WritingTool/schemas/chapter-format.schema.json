{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writingtool:proposed:chapter-format:1",
  "title": "Proposed formatting member, embedded in chapter JSON; not a complete chapter entity schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "chapterId": {
      "$ref": "urn:writingtool:proposed:foundation:1#/$defs/uuid"
    },
    "recordVersion": {
      "$ref": "urn:writingtool:proposed:foundation:1#/$defs/uuid"
    },
    "text": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "urn:writingtool:proposed:foundation:1#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "urn:writingtool:proposed:foundation:1#/$defs/sha256"
        },
        "byteLength": {
          "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
        },
        "scalarLength": {
          "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
        }
      },
      "required": [
        "relativePath",
        "sha256",
        "byteLength",
        "scalarLength"
      ],
      "additionalProperties": false
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:writingtool:proposed:foundation:1#/$defs/uuid"
          },
          "start": {
            "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
          },
          "end": {
            "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
          },
          "kind": {
            "enum": [
              "body",
              "heading",
              "scene-break"
            ]
          },
          "headingLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "indent": {
            "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
                },
                "end": {
                  "$ref": "urn:writingtool:proposed:foundation:1#/$defs/unsignedDecimal"
                },
                "styles": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "bold",
                      "italic"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "start",
                "end",
                "styles"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "kind",
          "indent",
          "marks"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "heading"
                }
              }
            },
            "then": {
              "required": [
                "headingLevel"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "headingLevel"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "formatVersion",
    "chapterId",
    "recordVersion",
    "text",
    "paragraphs"
  ],
  "additionalProperties": false
}
