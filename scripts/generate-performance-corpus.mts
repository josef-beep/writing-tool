export type CorpusCounts={stories:number;chapters:number;events:number;characters:number;factions:number;decisions:number;images:number;volumes:number;wordsPerChapter:number;imageWidth:number;imageHeight:number};
export const corpusCounts=(scale:1|10,tiny=false):CorpusCounts=>tiny?{stories:2,chapters:4,events:12,characters:4,factions:2,decisions:4,images:2,volumes:2,wordsPerChapter:50,imageWidth:16,imageHeight:16}:{stories:10*scale,chapters:100*scale,events:10000*scale,characters:200*scale,factions:20*scale,decisions:1000*scale,images:100*scale,volumes:2*scale,wordsPerChapter:2500,imageWidth:1536,imageHeight:1085};
const uuid=(seed:string)=>{const bytes=createHash('sha256').update(seed).digest().subarray(0,16);bytes[6]=(bytes[6]&15)|64;bytes[8]=(bytes[8]&63)|128;const hex=bytes.toString('hex');return `${hex.slice(0,8)}-${hex.slice(8,12)}-${hex.slice(12,16)}-${hex.slice(16,20)}-${hex.slice(20)}`;};
function chunk(kind:string,data:Buffer){const name=Buffer.from(kind),length=Buffer.alloc(4),checksum=Buffer.alloc(4);length.writeUInt32BE(data.length);checksum.writeUInt32BE(crc32(Buffer.concat([name,data])));return Buffer.concat([length,name,data,checksum]);}
export function corpusImage(index:number,width:number,height:number):Buffer{
 const key=createHash('sha256').update('WritingTool DEC-11 valid PNG pixels').digest(),iv=Buffer.alloc(16);iv.writeUInt32BE(index,12);
 const cipher=createCipheriv('aes-256-ctr',key,iv),rowBytes=width*3+1,rows=cipher.update(Buffer.alloc(rowBytes*height));
 for(let row=0;row<height;row++)rows[row*rowBytes]=0;
 const ihdr=Buffer.alloc(13);ihdr.writeUInt32BE(width);ihdr.writeUInt32BE(height,4);ihdr[8]=8;ihdr[9]=2;
 return Buffer.concat([Buffer.from('89504e470d0a1a0a','hex'),chunk('IHDR',ihdr),chunk('IDAT',deflateSync(rows,{level:0})),chunk('IEND',Buffer.alloc(0))]);
}
function paragraphs(text:string,seed:string):Paragraph[]{let offset=0;return text.split('\n').map((line,i)=>{const start=offset,end=start+Array.from(line).length;offset=end+1;return{id:uuid(seed+'/paragraph/'+i),start:String(start),end:String(end),indent:i%5===3?'2':'0',...(line==='***'?{kind:'scene-break' as const}:i===0?{kind:'heading' as const,headingLevel:2 as const}:{kind:'body' as const}),marks:line==='***'||end===start?[]:[{start:String(start),end:String(Math.min(end,start+5)),styles:i%2?['bold','italic']:['italic']}]};});}
function manuscript(chapter:number,words:number){const tokens=Array.from({length:words-1},(_,i)=>['café','chronology','writing','🌍','characters','and','decisions','remain','recoverable','today'][(i+chapter)%10]);tokens.splice(10,0,'***');return [tokens.slice(0,5).join(' '),tokens.slice(5,10).join(' '),'***',tokens.slice(11).join(' ')].join('\n');}
function relationships(record:WorkspaceRecord){const result:{sourceId:string;relation:string;targetId:string;targetUniverseId:string}[]=[];const add=(relation:string,targetId:string)=>result.push({sourceId:record.id,relation,targetId,targetUniverseId:record.universeId});switch(record.recordType){case'story':if(record.data.volumeId)add('volume',record.data.volumeId);break;case'chapter':add('story',record.data.storyId);record.data.characterIds.forEach(id=>add('character',id));record.data.events.forEach(e=>add('depicts:'+e.role,e.eventId));break;case'plot':add('story',record.data.storyId);break;case'decision-context':add('story',record.data.storyId);add('decision',record.data.decisionId);break;case'decision':add('type',record.data.typeId);record.data.characterIds.forEach(id=>add('relevant-character',id));record.data.eventIds.forEach(id=>add('result-event',id));record.data.followingDecisionIds.forEach(id=>add('following-decision',id));if(record.data.maker)add('maker',record.data.maker.id);break;case'event':if(record.data.maker)add('maker',record.data.maker.id);if(record.data.characterId)add(record.data.kind,record.data.characterId);break;case'character':if(record.data.birthEventId)add('birth',record.data.birthEventId);break;case'affiliation':add('character',record.data.characterId);if(record.data.factionId)add('faction',record.data.factionId);break;}return result;}
function sizeTree(root:string):{bytes:number;files:number}{let bytes=0,files=0;if(!fs.existsSync(root))return{bytes,files};for(const entry of fs.readdirSync(root,{withFileTypes:true})){const name=path.join(root,entry.name);if(entry.isDirectory()){const child=sizeTree(name);bytes+=child.bytes;files+=child.files;}else if(entry.isFile()){bytes+=fs.statSync(name).size;files++;}}return{bytes,files};}

/** Seeds only newly created, marked temporary fixtures; production reads validate the result. */
export function generateCorpus(root:string,scale:1|10,tiny=false){
 if(![1,10].includes(scale))throw new Error('Choose the approved baseline scale 1 or growth scale 10.');
 fs.mkdirSync(root);fs.writeFileSync(path.join(root,'.writingtool-performance-fixture.json'),JSON.stringify({schemaVersion:1,state:'building',scale,tiny}));
 for(const name of ['universe','project','profile','output'])fs.mkdirSync(path.join(root,name));
 const universePath=path.join(root,'universe'),projectPath=path.join(root,'project');
 const universe=new FileUniverseStorage().create(universePath,{operationId:randomUUID(),submittedEditorRevision:'0',data:{name:'DEC-11 '+(tiny?'tiny test':scale===1?'baseline':'ten-times'),description:'Generated isolated acceptance workload'}}).store;
 const universeIdentity=universe.snapshot(),project=new FileProjectStorage().create(projectPath,{operationId:randomUUID()},universeIdentity.ownerId,universePath).store;
 const projectIdentity=project.snapshot();project.close();universe.close();
 const counts=corpusCounts(scale,tiny),universeOwner:Owner={kind:'universe',id:universeIdentity.ownerId},projectOwner:Owner={kind:'project',id:projectIdentity.ownerId};
 const records:WorkspaceRecord[]=[],texts:Record<string,string>={},assets:{id:string;sha256:string;mediaType:'image/png';relativePath:string;byteLength:string}[]=[];
 const make=<K extends WorkspaceRecordType>(type:K,index:number,data:WorkspaceDataMap[K]):WorkspaceRecordOf<K>=>{const owner=['story','volume','chapter','plot','decision-context'].includes(type)?projectOwner:universeOwner;const record={schemaVersion:1 as const,id:uuid(`${scale}/${tiny}/${type}/${index}`),recordVersion:uuid(`${scale}/${tiny}/${type}/${index}/version/1`),recordType:type,owner,universeId:universeOwner.id,data};records.push(record as WorkspaceRecord);return record;};
 const calendarVersion=uuid(`${scale}/${tiny}/calendar/current`),month=uuid(`${scale}/${tiny}/calendar/month`);
 const calendar=make('calendar',0,{currentVersion:calendarVersion,anchor:{year:'0',day:'1'},versions:[{id:uuid(`${scale}/${tiny}/calendar/old`),elements:[],daysOnly:'360',actualDays:'360',targetDays:'360',enteredYear:'0',yearNames:[]},{id:calendarVersion,elements:[{id:month,kind:'month',name:'Dawn',days:'90'},{id:uuid(`${scale}/${tiny}/festival`),kind:'standalone',name:'Festival',days:'1'},{id:uuid(`${scale}/${tiny}/dusk`),kind:'month',name:'Dusk',days:'274'}],daysOnly:null,actualDays:'365',targetDays:'365',enteredYear:'0',yearNames:[{year:'0',name:'Founding'}]}]});
 const date=(i:number)=>({calendarVersion,year:String(Math.floor(i/365)-20),day:String(i%365+1)});
 for(let i=0;i<counts.images;i++){const bytes=corpusImage(i,counts.imageWidth,counts.imageHeight),id=uuid(`${scale}/${tiny}/image/${i}`),relativePath=`images/${id}.png`;fs.writeFileSync(path.join(universePath,relativePath),bytes);assets.push({id,sha256:hash(bytes),mediaType:'image/png',relativePath,byteLength:String(bytes.length)});}
 const image=(i:number)=>{const {id,sha256,mediaType}=assets[i%assets.length];return{id,sha256,mediaType};};
 const factions=Array.from({length:counts.factions},(_,i)=>make('faction',i,{name:`Faction ${i}`,description:'Independent faction profile',image:image(i),governmentType:'Council',governmentNotes:'Recorded charter',leaderImage:image(i+1),leaderName:`Leader ${i}`,leaderAge:'40',leaderReputation:'Known',leaderProfile:'A careful negotiator',militaryHead:'Commander',intelligenceHead:'Observer',overview:'Coastal communities',strengths:'Trade',weaknesses:'Winter',population:'100–200 estimated',resources:'Copper and grain',culture:'Stories and festivals',locations:[{name:`City ${i}`,notes:'River settlement'}],military:[{name:'Scouts',role:'Reconnaissance',description:'Optional roster',baseStrength:'1.5',movementPoints:'2',baseModifierPoints:'-0.5'}]}));
 const characters=Array.from({length:counts.characters},(_,i)=>make('character',i,{name:`Character ${i} café 🌍`,type:(['main','major','minor','extra'] as const)[i%4],rankTitle:'Navigator',background:'A remembered journey',description:'Detailed writing fixture',motivation:'Find a home',weaknesses:'Impatient',strengths:'Observation',specialities:'Maps',waivers:[],personalities:[],image:image(i),birth:null,birthEventId:null}));
 characters.forEach((character,i)=>make('affiliation',i,{characterId:character.id,date:date(i),order:'0',factionId:i%3?factions[i%factions.length].id:null}));
 const types=BUILTIN_DECISION_TYPES.map((data,i)=>make('decision-type',i,{...data}));
 const events=Array.from({length:counts.events},(_,i)=>make('event',i,{heading:`Event ${i} — shared chronology`,description:'A standalone event with retained Unicode café 🌍',date:date(i),code:'E'+String(i+1).padStart(3,'0'),order:'0',maker:i%3?{kind:'character',id:characters[i%characters.length].id}:null,kind:'ordinary',characterId:null}));
 const volumes=Array.from({length:counts.volumes},(_,i)=>make('volume',i,{title:`Volume ${i+1}`,order:String(i)}));
 const stories=Array.from({length:counts.stories},(_,i)=>make('story',i,{title:`Story ${i+1}`,creationSequence:String(i+1),order:String(i),volumeId:i%4===0?null:volumes[i%volumes.length].id,chapterTarget:'10'}));
 const chapters=Array.from({length:counts.chapters},(_,i)=>{const id=uuid(`${scale}/${tiny}/chapter/${i}`),recordVersion=uuid(`${scale}/${tiny}/chapter/${i}/version/1`),text=manuscript(i,counts.wordsPerChapter);texts[id]=text;return make('chapter',i,{title:`Chapter ${i+1}`,storyId:stories[i%stories.length].id,creationSequence:String(i+1),start:i%5?date(i*10):null,end:i%5?date(i*10+2):null,characterIds:[characters[i%characters.length].id],events:[{eventId:events[i%events.length].id,role:i%2?'main':'flashback'}],wordTarget:'2500',calendarUpdateRequired:false,formatting:{formatVersion:1,chapterId:id,recordVersion,text:{relativePath:`chapters/${id}.wrt`,sha256:hash(text),byteLength:String(Buffer.byteLength(text)),scalarLength:String(Array.from(text).length)},paragraphs:paragraphs(text,id)}});});
 stories.forEach((story,i)=>make('plot',i,{storyId:story.id,heading:`Plot ${i}`,date:i%3?date(i):null,order:'0'}));
 Array.from({length:counts.decisions},(_,i)=>{const event=events[i%events.length],decision=make('decision',i,{text:`Decision ${i}: preserve the established result`,date:event.data.date,typeId:types[i%types.length].id,code:'D'+String(i+1).padStart(3,'0'),order:'0',maker:i%types.length===0?{kind:'character',id:characters[i%characters.length].id}:null,characterIds:[characters[i%characters.length].id],eventIds:[event.id],followingDecisionIds:[]});make('decision-context',i,{storyId:stories[i%stories.length].id,decisionId:decision.id});return decision;});
 for(const record of records){const label=record.recordType+' '+record.id;if(!validateWorkspaceRecord(record))throw new Error('Invalid generated '+label);}
 assertWorkspaceState(records);
 for(const [location,owner] of [[universePath,universeOwner],[projectPath,projectOwner]] as const){
  const db=new DatabaseSync(path.join(location,'database/catalog.sqlite'));db.exec('PRAGMA synchronous=EXTRA;PRAGMA foreign_keys=ON;BEGIN IMMEDIATE');
  try{
   db.exec(WORKSPACE_DDL);const insertRecord=db.prepare('INSERT INTO workspace_records VALUES(?,?,?,?,?,0,NULL)'),insertFile=db.prepare('INSERT INTO workspace_files VALUES(?,?,?,?,?,?)'),insertVersion=db.prepare('INSERT INTO workspace_versions VALUES(?,?,?,?,?)'),insertRelation=db.prepare('INSERT INTO workspace_relationships VALUES(?,?,?,?)'),insertCode=db.prepare('INSERT INTO workspace_codes VALUES(?,?,?)');
   const write=(relative:string,bytes:Buffer)=>{const file=path.join(location,relative);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,bytes);};
   for(const record of records.filter(r=>r.owner.kind===owner.kind)){
    const relative=`${recordCategory[record.recordType]}/${record.id}.json`,bytes=Buffer.from(jsonBytes(record)),jsonPath=`history/objects/${record.recordVersion}/${relative}`;
    write(relative,bytes);write(jsonPath,bytes);insertRecord.run(record.id,record.recordType,record.recordVersion,relative,hash(bytes));insertFile.run(relative,record.id,record.recordVersion,'json',hash(bytes),String(bytes.length));
    const manuscriptPath=record.recordType==='chapter'?`history/objects/${record.recordVersion}/chapters/${record.id}.wrt`:null;
    insertVersion.run(record.recordVersion,record.id,record.recordType,jsonPath,manuscriptPath);
    if(record.recordType==='chapter'){const text=Buffer.from(texts[record.id]);write(record.data.formatting.text.relativePath,text);write(manuscriptPath!,text);insertFile.run(record.data.formatting.text.relativePath,record.id,record.recordVersion,'wrt',hash(text),String(text.length));
     for(let revision=0;revision<2;revision++){const older=structuredClone(record),version=uuid(record.id+'/retained/'+revision),oldText=`Retained ${revision} café 🌍`;
      older.recordVersion=version;older.data.formatting={...older.data.formatting,recordVersion:version,text:{...older.data.formatting.text,sha256:hash(oldText),byteLength:String(Buffer.byteLength(oldText)),scalarLength:String(Array.from(oldText).length)},paragraphs:paragraphs(oldText,version)};
      const oldJson=`history/objects/${version}/${relative}`,oldWrt=`history/objects/${version}/chapters/${record.id}.wrt`;write(oldJson,Buffer.from(jsonBytes(older)));write(oldWrt,Buffer.from(oldText));insertVersion.run(version,record.id,record.recordType,oldJson,oldWrt);
     }
    }
    relationships(record).forEach(r=>insertRelation.run(r.sourceId,r.relation,r.targetId,r.targetUniverseId));if(record.recordType==='event'||record.recordType==='decision')insertCode.run(record.id,record.data.code,canonicalCodeKey(record.data.code));
   }
   if(owner.kind==='universe'){const insertAsset=db.prepare('INSERT INTO workspace_assets VALUES(?,?,?,?,?)');for(const a of assets)insertAsset.run(a.id,a.sha256,a.mediaType,a.relativePath,a.byteLength);}
   const counters=owner.kind==='universe'?{event:counts.events,decision:counts.decisions,story:0,chapter:0}:{event:0,decision:0,story:counts.stories,chapter:counts.chapters};for(const [kind,issued] of Object.entries(counters))db.prepare('UPDATE workspace_counters SET issued=? WHERE kind=?').run(String(issued),kind);
   const operationId=uuid(owner.id+'/corpus-seed'),receipt=jsonBytes({protocolVersion:1,operationId,submittedEditorRevision:'0',units:[{owner,unitGeneration:'2',records:records.filter(r=>r.owner.kind===owner.kind).map(r=>({id:r.id,recordVersion:r.recordVersion,deleted:false}))}]});db.prepare('INSERT INTO committed_operations VALUES(?,?,?,?,?)').run(operationId,hash('DEC-11 isolated fixture seed'),'2',hash(receipt),receipt);db.exec("UPDATE unit_meta SET generation='2';COMMIT");if(db.prepare('PRAGMA quick_check').get()?.quick_check!=='ok')throw new Error('Generated catalog failed integrity checking.');
  }catch(error){if(db.isTransaction)db.exec('ROLLBACK');throw error;}finally{db.close();}
 }
 const manifest={schemaVersion:1,state:'seeded-requires-runtime-validation',scale,tiny,root,counts,words:Object.values(texts).reduce((sum,text)=>sum+text.trim().split(/\s+/u).length,0),imageBytes:assets.reduce((sum,a)=>sum+Number(a.byteLength),0),images:assets.map(a=>({id:a.id,sha256:a.sha256,bytes:a.byteLength})),recordCounts:Object.fromEntries([...new Set(records.map(r=>r.recordType))].map(type=>[type,records.filter(r=>r.recordType===type).length])),projectIdentity,universeIdentity,storyIds:stories.map(r=>r.id),chapterIds:chapters.map(r=>r.id),calendarId:calendar.id,sizes:{project:sizeTree(projectPath),universe:sizeTree(universePath),history:{project:sizeTree(path.join(projectPath,'history')),universe:sizeTree(path.join(universePath,'history'))}},construction:'New isolated fixture catalogs/category files only; production runtime validation is required before measurements. This is not publication durability evidence.',hardware:{platform:os.platform(),release:os.release(),cpu:os.cpus()[0]?.model,logicalCpus:os.cpus().length,memoryBytes:os.totalmem()},generatedAt:new Date().toISOString()};
 fs.writeFileSync(path.join(root,'corpus.json'),JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(root,'.writingtool-performance-fixture.json'),JSON.stringify({schemaVersion:1,state:'seeded',scale,tiny}));return manifest;
}

if(process.argv[1]&&import.meta.url===pathToFileURL(path.resolve(process.argv[1])).href){const args=process.argv.slice(2),scale=Number(args.find(a=>a.startsWith('--scale='))?.slice(8)??'1');if(scale!==1&&scale!==10)throw new Error('Expected --scale=1 or --scale=10.');const output=args.find(a=>a.startsWith('--output='))?.slice(9)??path.join(fs.mkdtempSync(path.join(os.tmpdir(),'writingtool-dec11-')),'corpus');const result=generateCorpus(path.resolve(output),scale,args.includes('--tiny'));console.log(JSON.stringify({root:result.root,counts:result.counts,words:result.words,imageBytes:result.imageBytes,sizes:result.sizes}));}
