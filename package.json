{
  "name": "writingtool",
  "productName": "WritingTool",
  "version": "0.1.0",
  "private": true,
  "description": "Local WritingTool desktop foundation",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "josef-beep",
    "email": "colligentes@gmail.com"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint --deny-warnings src tests scripts",
    "lint:fix": "oxlint --fix src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/readiness.test.ts && node --import tsx tests/universe.test.ts && node tests/smoke.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "postinstall": "node node_modules/electron/install.js",
    "setup:resources": "node scripts/setup-resources.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.9.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "oxlint": "^1.88.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "0.8.3",
    "lexical": "0.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
